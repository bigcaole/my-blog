---
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  description?: string;
  canonical?: string;
  slug?: string;
  [key: string]: any;
};

const { title, description = "", canonical } = Astro.props as Props;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
});
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script is:inline slot="head" type="application/ld+json" set:html={structuredData}></script>
  <section class="mx-auto w-full max-w-5xl px-4 py-10">
    <div class="mb-6">
      <a
        href="/tools"
        class="inline-flex items-center gap-2 rounded-xl border px-3 py-2 text-sm transition hover:bg-[var(--bg-elev-2)]"
        style="border-color: var(--border); color: var(--text)"
      >
        <span aria-hidden="true">←</span>
        返回工具箱
      </a>
    </div>

    <header class="mb-6">
      <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--text)">{title}</h1>
      {description ? <p class="mt-2 max-w-2xl text-sm" style="color: var(--text-muted)">{description}</p> : null}
    </header>

    <div>
      <slot />
    </div>
  </section>
</BaseLayout>
