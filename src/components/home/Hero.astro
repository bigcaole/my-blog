---
import { SITE } from '../../config/site';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Badge from '../ui/Badge.astro';

type Props = {
  stats: Array<{ label: string; value: string; icon?: string }>;
};
const { stats } = Astro.props as Props;
---

<section class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
  <div>
    <div class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs shadow-sm" style="border-color: var(--border); background: var(--bg-elev-1); color: var(--text-muted)">
      <Icon name="sparkles" size={14} />
      <span>极简 · 工具型 · 静态站</span>
    </div>

    <h1
      class="mt-5 bg-[linear-gradient(135deg,var(--primary),var(--accent))] bg-clip-text text-4xl font-semibold tracking-tight text-transparent sm:text-5xl"
    >
      {SITE.name}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-7" style="color: var(--text-muted)">{SITE.slogan}</p>
    <p class="mt-3 max-w-2xl text-sm leading-7" style="color: var(--text-muted)">{SITE.description}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      <Button variant="primary" href="/posts/">
        <Icon name="posts" size={16} /> 查看文章
      </Button>
      <Button variant="secondary" href="/tools/">
        <Icon name="tools" size={16} /> 工具箱
      </Button>
    </div>
  </div>

  <div class="ui-card p-5">
    <SectionTitle title="站点概览" description="持续迭代，但保持极简。" barClass="border-sky-500" />
    <div class="mt-5 grid grid-cols-2 gap-3">
      {stats.map((s) => (
        <div class="relative overflow-hidden rounded-2xl border p-4" style="border-color: var(--border); background: var(--bg-elev-2)">
          <div class="absolute inset-x-0 top-0 h-1" style="background: linear-gradient(90deg, var(--primary), var(--accent));"></div>
          <div class="text-xs" style="color: var(--text-muted)">{s.label}</div>
          <div class="mt-1 flex items-center gap-2">
            <div class="text-lg font-semibold">{s.value}</div>
            <Badge variant="accent" class="hidden sm:inline-flex">Live</Badge>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
