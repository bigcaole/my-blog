---
import { SITE } from '../../config/site';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import SearchBox from './SearchBox.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="ui-header sticky top-0 z-50">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
    <a href="/" class="inline-flex items-center gap-2 no-underline">
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-white"
        style="background: linear-gradient(135deg, var(--primary), var(--accent));"
      >
        <Icon name="sparkles" size={18} />
      </span>
      <div class="hidden sm:block">
        <div class="text-sm font-semibold tracking-tight">{SITE.name}</div>
        <div class="text-xs" style="color: var(--text-muted)">{SITE.slogan}</div>
      </div>
    </a>

    <nav class="ml-2 hidden flex-1 items-center gap-1 md:flex" aria-label="主导航">
      {SITE.nav.map((item) => (
        <a
          class="inline-flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-[var(--text-muted)] hover:text-[var(--primary)] hover:underline"
          href={item.href}
        >
          {item.icon ? <Icon name={item.icon} size={16} class="opacity-70" /> : null}
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="ml-auto md:ml-0">
      <SearchBox />
    </div>

    <div class="flex items-center gap-2">
      {SITE.social.github ? (
        <Button
          variant="ghost"
          href={SITE.social.github}
          target="_blank"
          rel="noreferrer"
          class="h-9 w-9 px-0 text-[var(--text-muted)] hover:text-[var(--primary)]"
          aria-label="GitHub"
          title="GitHub"
        >
          <Icon name="github" />
        </Button>
      ) : null}
      {SITE.social.telegram ? (
        <Button
          variant="ghost"
          href={SITE.social.telegram}
          target="_blank"
          rel="noreferrer"
          class="h-9 w-9 px-0 text-[var(--text-muted)] hover:text-[var(--primary)]"
          aria-label="Telegram"
          title="Telegram"
        >
          <Icon name="telegram" />
        </Button>
      ) : null}

      <ThemeToggle />

      <button
        class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--bg-elev-1)] text-[var(--text-muted)] shadow-sm hover:bg-[var(--bg-elev-2)] md:hidden"
        type="button"
        aria-label="打开菜单"
        data-mobile-menu-toggle
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div class="mx-auto hidden max-w-6xl px-4 pb-4 md:hidden" data-mobile-menu>
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elev-1)] p-3 shadow-sm">
      <div class="grid gap-1">
        {SITE.nav.map((item) => (
          <a
            class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-[var(--text-muted)] hover:bg-[var(--bg-elev-2)] hover:text-[var(--primary)]"
            href={item.href}
          >
            {item.icon ? <Icon name={item.icon} size={16} class="opacity-70" /> : null}
            {item.label}
          </a>
        ))}
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        {SITE.social.github ? (
          <Button variant="secondary" href={SITE.social.github} target="_blank" rel="noreferrer">
            <Icon name="github" size={16} /> GitHub
          </Button>
        ) : null}
        {SITE.social.telegram ? (
          <Button variant="secondary" href={SITE.social.telegram} target="_blank" rel="noreferrer">
            <Icon name="telegram" size={16} /> Telegram
          </Button>
        ) : null}
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.currentScript?.previousElementSibling;
    if (!header) return;
    const btn = header.querySelector('[data-mobile-menu-toggle]');
    const menu = header.querySelector('[data-mobile-menu]');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  })();
</script>
