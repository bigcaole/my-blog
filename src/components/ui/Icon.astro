const icon = ICONS[name] || ICONS.sparkles;
const ariaAttrs = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill="none"
  stroke="currentColor"
  strokeWidth={strokeWidth}
  strokeLinecap="round"
  strokeLinejoin="round"
  class={className}
  {...ariaAttrs}
  set:html={icon.body}
></svg>

