const def: IconDef = ICONS[name] ?? { viewBox: '0 0 24 24', paths: ['M12 2a10 10 0 1 1 0 20a10 10 0 0 1 0-20z', 'M12 8h.01', 'M11 11h2v7h-2z'] };

const ariaHidden = !ariaLabel && !title ? 'true' : undefined;
---

<svg
  width={size}
  height={size}
  viewBox={def.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role="img"
  aria-hidden={ariaHidden}
  aria-label={ariaLabel}
>
  {title ? <title>{title}</title> : null}
  {def.paths.map((d) => (
    <path d={d} />
  ))}
</svg>

