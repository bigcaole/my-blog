const def = icons[name];
---
<svg
  width={size}
  height={size}
  viewBox={def.viewBox ?? '0 0 24 24'}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : 'presentation'}
  aria-label={title}
>
  {title ? <title>{title}</title> : null}
  {def.paths.map((d) => (
    <path d={d} />
  ))}
</svg>

