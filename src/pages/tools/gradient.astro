---
import ToolLayout from "../../layouts/ToolLayout.astro";

const title = "CSS 渐变生成器";
const description = "选择颜色和角度，实时生成 linear-gradient CSS 代码。";
---

<ToolLayout title={title} description={description}>
  <div class="grid gap-4 lg:grid-cols-[340px_1fr]">
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <label class="grid gap-2 text-sm" style="color: var(--text)">起始颜色 <input id="c1" type="color" value="#6366f1" class="h-12 w-full rounded-xl border p-1" style="border-color: var(--border)" /></label>
      <label class="mt-3 grid gap-2 text-sm" style="color: var(--text)">结束颜色 <input id="c2" type="color" value="#10b981" class="h-12 w-full rounded-xl border p-1" style="border-color: var(--border)" /></label>
      <label class="mt-3 grid gap-2 text-sm" style="color: var(--text)">角度 <input id="angle" type="range" min="0" max="360" value="135" /></label>
      <div id="angleText" class="mt-1 text-sm" style="color: var(--text-muted)">135deg</div>
      <button id="copy" class="ui-btn ui-btn--primary mt-4 w-full" type="button">复制 CSS</button>
    </section>
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <div id="preview" class="h-64 rounded-xl border" style="border-color: var(--border)"></div>
      <textarea id="css" class="mt-4 min-h-[110px] w-full resize-y rounded-xl border p-3 font-mono text-sm outline-none" style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)" readonly></textarea>
    </section>
  </div>

  <script is:inline>
    const c1 = document.getElementById("c1"), c2 = document.getElementById("c2"), angle = document.getElementById("angle");
    function render() {
      const css = `background: linear-gradient(${angle.value}deg, ${c1.value}, ${c2.value});`;
      document.getElementById("preview").style.cssText = `${css} border-color: var(--border)`;
      document.getElementById("css").value = css;
      document.getElementById("angleText").textContent = `${angle.value}deg`;
    }
    [c1, c2, angle].forEach((el) => el.addEventListener("input", render));
    document.getElementById("copy").addEventListener("click", () => navigator.clipboard.writeText(document.getElementById("css").value));
    render();
  </script>
</ToolLayout>
