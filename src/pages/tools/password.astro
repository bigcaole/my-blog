---
import ToolLayout from "../../layouts/ToolLayout.astro";
import PrivacyNotice from "../../components/tools/PrivacyNotice.astro";

const title = "随机密码生成器";
const description = "自定义长度和字符集，使用浏览器加密随机数生成高强度密码。";
---

<ToolLayout title={title} description={description}>
  <PrivacyNotice />
  <div class="grid gap-4 lg:grid-cols-[340px_1fr]">
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <label class="grid gap-2 text-sm" style="color: var(--text)">长度
        <input id="length" class="ui-input" type="number" min="6" max="128" value="24" />
      </label>
      <div class="mt-4 grid gap-3 text-sm" style="color: var(--text)">
        <label class="flex items-center gap-2"><input id="upper" type="checkbox" checked /> 大写字母</label>
        <label class="flex items-center gap-2"><input id="lower" type="checkbox" checked /> 小写字母</label>
        <label class="flex items-center gap-2"><input id="digits" type="checkbox" checked /> 数字</label>
        <label class="flex items-center gap-2"><input id="symbols" type="checkbox" checked /> 特殊符号</label>
      </div>
      <button id="gen" class="ui-btn ui-btn--primary mt-4 w-full" type="button">生成</button>
    </section>
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <div class="mb-2 flex items-center justify-between">
        <div class="text-sm font-medium" style="color: var(--text)">密码</div>
        <button id="copy" class="ui-btn ui-btn--secondary" type="button">复制</button>
      </div>
      <textarea id="out" class="min-h-[160px] w-full resize-y rounded-xl border p-3 font-mono text-lg outline-none" style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)" readonly></textarea>
      <p id="hint" class="mt-3 text-sm" style="color: var(--text-muted)"></p>
    </section>
  </div>

  <script is:inline>
    const sets = { upper: "ABCDEFGHIJKLMNOPQRSTUVWXYZ", lower: "abcdefghijklmnopqrstuvwxyz", digits: "0123456789", symbols: "!@#$%^&*()_+-=[]{}|;:,.<>?" };
    function randomInt(max) {
      const arr = new Uint32Array(1);
      crypto.getRandomValues(arr);
      return arr[0] % max;
    }
    function gen() {
      const length = Math.min(128, Math.max(6, Number(document.getElementById("length").value) || 24));
      const pool = Object.keys(sets).filter((id) => document.getElementById(id).checked).map((id) => sets[id]).join("");
      if (!pool) {
        document.getElementById("hint").textContent = "请至少选择一种字符集。";
        return;
      }
      let pass = "";
      for (let i = 0; i < length; i++) pass += pool[randomInt(pool.length)];
      document.getElementById("out").value = pass;
      document.getElementById("hint").textContent = `长度 ${length}，字符池 ${pool.length} 个字符。`;
    }
    document.getElementById("gen").addEventListener("click", gen);
    document.getElementById("copy").addEventListener("click", () => navigator.clipboard.writeText(document.getElementById("out").value || ""));
    gen();
  </script>
</ToolLayout>
