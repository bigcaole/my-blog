---
import ToolLayout from "../../layouts/ToolLayout.astro";

const title = "Cron 下一次执行时间";
const description = "输入 5 段 Cron（分/时/日/月/周），展示本地时区未来 5 次触发时间。";
---

<ToolLayout title={title} description={description}>
  <div class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
    <label class="text-sm font-medium" style="color: var(--text)" for="cron">Cron 表达式（5 段）</label>
    <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
      <input
        id="cron"
        class="w-full rounded-xl border px-3 py-2 text-sm outline-none"
        style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)"
        placeholder="例如：*/5 * * * *"
        value="*/5 * * * *"
      />
      <button
        id="btn"
        class="shrink-0 rounded-xl px-3 py-2 text-sm font-medium shadow-sm transition active:scale-[0.98]"
        style="background: linear-gradient(135deg, var(--primary), var(--accent)); color: white"
        type="button"
      >
        计算
      </button>
    </div>
    <p class="mt-2 text-sm" style="color: var(--text-muted)">
      说明：当“日”和“周”都不是 <code>*</code> 时，按常见 cron 语义使用“或”（满足其一即可）。
    </p>
    <p id="err" class="mt-3 hidden text-sm" style="color: #ef4444" aria-live="polite"></p>

    <div class="mt-4 rounded-xl border p-3" style="border-color: var(--border); background: var(--bg-elev-2)">
      <div class="text-sm font-medium" style="color: var(--text)">未来 5 次</div>
      <ol id="list" class="mt-2 grid gap-2 text-sm"></ol>
    </div>
  </div>

  <script is:inline>
    const $cron = document.getElementById("cron");
    const $btn = document.getElementById("btn");
    const $err = document.getElementById("err");
    const $list = document.getElementById("list");

    function showError(msg) {
      $err.textContent = msg;
      $err.classList.remove("hidden");
    }
    function clearError() {
      $err.textContent = "";
      $err.classList.add("hidden");
    }

    function range(min, max) {
      const out = [];
      for (let i = min; i <= max; i++) out.push(i);
      return out;
    }

    function parseField(src, min, max, { map7to0 = false } = {}) {
      const trimmed = (src || "").trim();
      if (!trimmed) return null;

      const all = new Set(range(min, max));
      if (trimmed === "*") return { any: true, values: all };

      const out = new Set();
      const parts = trimmed.split(",");
      for (const part0 of parts) {
        const part = part0.trim();
        if (!part) return null;

        let base = part;
        let step = 1;
        if (part.includes("/")) {
          const segs = part.split("/");
          if (segs.length !== 2) return null;
          base = segs[0].trim();
          step = Number(segs[1]);
          if (!Number.isFinite(step) || step <= 0) return null;
        }

        const addVal = (v) => {
          let vv = v;
          if (map7to0 && vv === 7) vv = 0;
          if (vv < min || vv > max) return false;
          out.add(vv);
          return true;
        };

        if (base === "*" || base === "") {
          for (let v = min; v <= max; v += step) addVal(v);
          continue;
        }

        if (base.includes("-")) {
          const segs = base.split("-");
          if (segs.length !== 2) return null;
          const a = Number(segs[0]);
          const b = Number(segs[1]);
          if (!Number.isFinite(a) || !Number.isFinite(b)) return null;
          const start = Math.min(a, b);
          const end = Math.max(a, b);
          for (let v = start; v <= end; v += step) {
            if (!addVal(v)) return null;
          }
          continue;
        }

        const n = Number(base);
        if (!Number.isFinite(n)) return null;
        if (step !== 1) {
          // single number with step is unusual; treat as "n" only
          if (!addVal(n)) return null;
        } else {
          if (!addVal(n)) return null;
        }
      }

      if (out.size === 0) return null;
      return { any: false, values: out };
    }

    function matchCron(date, cron) {
      const m = date.getMinutes();
      const h = date.getHours();
      const dom = date.getDate();
      const mon = date.getMonth() + 1;
      const dow = date.getDay(); // 0=Sun

      if (!cron.min.values.has(m)) return false;
      if (!cron.hour.values.has(h)) return false;
      if (!cron.month.values.has(mon)) return false;

      const domAny = cron.dom.any;
      const dowAny = cron.dow.any;
      const domMatch = cron.dom.values.has(dom);
      const dowMatch = cron.dow.values.has(dow);

      let dayOk = true;
      if (domAny && dowAny) dayOk = true;
      else if (domAny) dayOk = dowMatch;
      else if (dowAny) dayOk = domMatch;
      else dayOk = domMatch || dowMatch;

      return dayOk;
    }

    function computeNext(expr) {
      const parts = expr.trim().split(/\s+/);
      if (parts.length !== 5) throw new Error("Cron 必须是 5 段：分 时 日 月 周");

      const minF = parseField(parts[0], 0, 59);
      const hourF = parseField(parts[1], 0, 23);
      const domF = parseField(parts[2], 1, 31);
      const monthF = parseField(parts[3], 1, 12);
      const dowF = parseField(parts[4], 0, 6, { map7to0: true });
      if (!minF || !hourF || !domF || !monthF || !dowF) throw new Error("Cron 格式不合法（仅支持数字、*、逗号、范围、步进）");

      const cron = { min: minF, hour: hourF, dom: domF, month: monthF, dow: dowF };

      const out = [];
      const now = new Date();
      now.setSeconds(0, 0);
      let t = new Date(now.getTime() + 60_000);

      // Safety cap: search up to ~370 days (minutes)
      const maxIter = 60 * 24 * 370;
      for (let i = 0; i < maxIter && out.length < 5; i++) {
        if (matchCron(t, cron)) out.push(new Date(t));
        t = new Date(t.getTime() + 60_000);
      }
      return out;
    }

    function render(list) {
      $list.innerHTML = "";
      if (!list.length) {
        const li = document.createElement("li");
        li.textContent = "未找到未来触发时间（请检查表达式）。";
        li.style.color = "var(--text-muted)";
        $list.appendChild(li);
        return;
      }
      for (const d of list) {
        const li = document.createElement("li");
        li.className = "rounded-lg border px-3 py-2";
        li.style.borderColor = "var(--border)";
        li.style.background = "var(--bg-elev-1)";
        li.style.color = "var(--text)";
        li.textContent = d.toLocaleString();
        $list.appendChild(li);
      }
    }

    function run() {
      clearError();
      try {
        const list = computeNext($cron.value);
        render(list);
      } catch (e) {
        showError(e && e.message ? e.message : "计算失败：请检查 Cron 表达式。");
        render([]);
      }
    }

    $btn.addEventListener("click", run);
    $cron.addEventListener("keydown", (e) => {
      if (e.key === "Enter") run();
    });

    run();
  </script>
</ToolLayout>

