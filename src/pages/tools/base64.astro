---
import ToolLayout from "../../layouts/ToolLayout.astro";

const title = "Base64 编码/解码";
const description = "文本 ↔ Base64（UTF-8），支持复制结果与友好错误提示。";
---

<ToolLayout title={title} description={description}>
  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <div class="mb-2 text-sm font-medium" style="color: var(--text)">输入</div>
      <textarea
        id="in"
        class="min-h-[220px] w-full resize-y rounded-xl border px-3 py-2 text-sm outline-none"
        style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)"
        placeholder="输入要编码/解码的内容…"
      ></textarea>

      <div class="mt-3 flex flex-wrap gap-2">
        <button
          id="btnEncode"
          class="rounded-xl px-3 py-2 text-sm font-medium shadow-sm transition active:scale-[0.98]"
          style="background: linear-gradient(135deg, var(--primary), var(--accent)); color: white"
          type="button"
        >
          编码 → Base64
        </button>
        <button
          id="btnDecode"
          class="rounded-xl border px-3 py-2 text-sm font-medium transition hover:bg-[var(--bg-elev-2)]"
          style="border-color: var(--border); color: var(--text)"
          type="button"
        >
          解码 ← Base64
        </button>
        <button
          id="btnClear"
          class="rounded-xl border px-3 py-2 text-sm font-medium transition hover:bg-[var(--bg-elev-2)]"
          style="border-color: var(--border); color: var(--text)"
          type="button"
        >
          清空
        </button>
      </div>

      <p id="err" class="mt-3 hidden text-sm" style="color: #ef4444" aria-live="polite"></p>
    </div>

    <div class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <div class="mb-2 flex items-center justify-between gap-3">
        <div class="text-sm font-medium" style="color: var(--text)">结果</div>
        <button
          id="btnCopy"
          class="rounded-xl border px-3 py-2 text-sm font-medium transition hover:bg-[var(--bg-elev-2)]"
          style="border-color: var(--border); color: var(--text)"
          type="button"
        >
          复制
        </button>
      </div>
      <textarea
        id="out"
        class="min-h-[220px] w-full resize-y rounded-xl border px-3 py-2 text-sm outline-none"
        style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)"
        placeholder="这里会显示结果…"
        readonly
      ></textarea>
      <p id="copied" class="mt-2 hidden text-sm" style="color: var(--text-muted)" aria-live="polite">已复制。</p>
    </div>
  </div>

  <script>
    const $in = document.getElementById("in");
    const $out = document.getElementById("out");
    const $err = document.getElementById("err");
    const $copied = document.getElementById("copied");

    function showError(msg) {
      $err.textContent = msg;
      $err.classList.remove("hidden");
    }
    function clearError() {
      $err.textContent = "";
      $err.classList.add("hidden");
    }
    function hideCopied() {
      $copied.classList.add("hidden");
    }
    function showCopied() {
      $copied.classList.remove("hidden");
      window.setTimeout(hideCopied, 1200);
    }

    function bytesToBase64(bytes) {
      let bin = "";
      for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin);
    }
    function base64ToBytes(b64) {
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return bytes;
    }

    function encodeUtf8ToBase64(str) {
      const bytes = new TextEncoder().encode(str);
      return bytesToBase64(bytes);
    }
    function decodeBase64ToUtf8(b64) {
      const bytes = base64ToBytes(b64.trim());
      return new TextDecoder().decode(bytes);
    }

    document.getElementById("btnEncode").addEventListener("click", () => {
      hideCopied();
      clearError();
      try {
        $out.value = encodeUtf8ToBase64($in.value || "");
      } catch (e) {
        showError("编码失败：请检查输入内容。");
      }
    });

    document.getElementById("btnDecode").addEventListener("click", () => {
      hideCopied();
      clearError();
      try {
        $out.value = decodeBase64ToUtf8($in.value || "");
      } catch (e) {
        showError("解码失败：Base64 格式可能不正确。");
      }
    });

    document.getElementById("btnClear").addEventListener("click", () => {
      hideCopied();
      clearError();
      $in.value = "";
      $out.value = "";
    });

    document.getElementById("btnCopy").addEventListener("click", async () => {
      hideCopied();
      clearError();
      try {
        await navigator.clipboard.writeText($out.value || "");
        showCopied();
      } catch (e) {
        showError("复制失败：请手动选择并复制结果。");
      }
    });
  </script>
</ToolLayout>

