---
import ToolLayout from "../../layouts/ToolLayout.astro";

const title = "代码压缩/美化";
const description = "支持 HTML、CSS、JavaScript 的单行压缩和多行美化。";
---

<ToolLayout title={title} description={description}>
  <div class="grid gap-4">
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <div class="grid gap-3 sm:grid-cols-[180px_1fr_auto_auto] sm:items-end">
        <label class="grid gap-2 text-sm" style="color: var(--text)">语言
          <select id="lang" class="ui-input">
            <option value="js">JavaScript</option>
            <option value="css">CSS</option>
            <option value="html">HTML</option>
          </select>
        </label>
        <div></div>
        <button id="beautify" type="button" class="ui-btn ui-btn--primary">美化</button>
        <button id="minify" type="button" class="ui-btn ui-btn--secondary">压缩</button>
      </div>
      <p id="error" class="mt-3 hidden text-sm" style="color: #ef4444"></p>
    </section>
    <div class="grid gap-4 lg:grid-cols-2">
      <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
        <label class="text-sm font-medium" style="color: var(--text)" for="input">输入</label>
        <textarea id="input" class="mt-2 min-h-[340px] w-full resize-y rounded-xl border p-3 font-mono text-sm outline-none" style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)" spellcheck="false" placeholder='function hello(name) { console.log("hello " + name); }'></textarea>
      </section>
      <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
        <div class="mb-2 flex items-center justify-between">
          <div class="text-sm font-medium" style="color: var(--text)">输出</div>
          <div class="flex gap-2">
            <button id="copy" type="button" class="ui-btn ui-btn--secondary">复制</button>
            <button type="button" class="ui-btn ui-btn--secondary" data-download-target="#output" data-filename="formatted-code.txt">下载</button>
          </div>
        </div>
        <textarea id="output" class="min-h-[340px] w-full resize-y rounded-xl border p-3 font-mono text-sm outline-none" style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)" readonly></textarea>
      </section>
    </div>
  </div>

  <script>
    // @ts-nocheck
    const lang = document.getElementById("lang");
    const input = document.getElementById("input");
    const output = document.getElementById("output");
    const error = document.getElementById("error");
    const opts = { indent_size: 2, preserve_newlines: true };
    let beautifyLib;
    async function loadBeautify() {
      if (!beautifyLib) {
        const mod = await import("js-beautify");
        beautifyLib = mod.default || mod;
      }
      return beautifyLib;
    }
    function clearError() { error.classList.add("hidden"); error.textContent = ""; }
    function showError(err) { error.textContent = err?.message || "处理失败。"; error.classList.remove("hidden"); }
    function minifyCss(source) {
      return source.replace(/\/\*[\s\S]*?\*\//g, "").replace(/\s+/g, " ").replace(/\s*([{}:;,>+~])\s*/g, "$1").replace(/;}/g, "}").trim();
    }
    function minifyHtml(source) {
      return source.replace(/<!--[\s\S]*?-->/g, "").replace(/>\s+</g, "><").replace(/\s{2,}/g, " ").trim();
    }
    function minifyJs(source) {
      return source.replace(/\/\*[\s\S]*?\*\//g, "").replace(/(^|[^:])\/\/.*$/gm, "$1").replace(/\s+/g, " ").replace(/\s*([{}()[\];,:+\-*/%=<>])\s*/g, "$1").trim();
    }
    document.getElementById("beautify").addEventListener("click", async () => {
      clearError();
      try {
        const beautify = await loadBeautify();
        output.value = lang.value === "css" ? beautify.css(input.value, opts) : lang.value === "html" ? beautify.html(input.value, opts) : beautify.js(input.value, opts);
      } catch (err) { showError(err); }
    });
    document.getElementById("minify").addEventListener("click", () => {
      clearError();
      try {
        if (lang.value === "js") output.value = minifyJs(input.value);
        else if (lang.value === "css") output.value = minifyCss(input.value);
        else output.value = minifyHtml(input.value);
      } catch (err) { showError(err); }
    });
    input.value = 'function hello(name) {\n  console.log("hello " + name);\n}';
    document.getElementById("copy").addEventListener("click", () => navigator.clipboard.writeText(output.value || ""));
  </script>
</ToolLayout>
