---
import ToolLayout from "../../layouts/ToolLayout.astro";

const title = "字数统计";
const description = "实时统计中文字数、英文词数、字符、标点、空格、段落与预估阅读时间。";
---

<ToolLayout title={title} description={description}>
  <div class="grid gap-4 lg:grid-cols-[1fr_340px]">
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <label for="text" class="text-sm font-medium" style="color: var(--text)">文本</label>
      <textarea id="text" class="mt-2 min-h-[420px] w-full resize-y rounded-xl border p-3 text-sm outline-none" style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)" placeholder="输入或粘贴文本…">这是一个测试段落。
Hello world, count me!</textarea>
    </section>
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <div class="text-sm font-medium" style="color: var(--text)">统计</div>
      <dl id="stats" class="mt-3 grid gap-2 text-sm"></dl>
    </section>
  </div>

  <script is:inline>
    const text = document.getElementById("text");
    const stats = document.getElementById("stats");
    function count() {
      const s = text.value || "";
      const chinese = (s.match(/[\u4e00-\u9fff]/g) || []).length;
      const words = (s.match(/[A-Za-z]+(?:[-'][A-Za-z]+)?/g) || []).length;
      const punct = (s.match(/[!"#$%&'()*+,\-./:;<=>?@[\\\]^_`{|}~，。！？、；：“”‘’（）【】《》]/g) || []).length;
      const spaces = (s.match(/\s/g) || []).length;
      const paragraphs = s.trim() ? s.trim().split(/\n\s*\n|\n/).filter(Boolean).length : 0;
      const reading = Math.max(1, Math.ceil((chinese + words) / 300));
      const rows = [["中文字数", chinese], ["英文词数", words], ["总字符", s.length], ["非空字符", s.replace(/\s/g, "").length], ["标点符号", punct], ["空白字符", spaces], ["段落", paragraphs], ["阅读时间", `${reading} 分钟`]];
      stats.innerHTML = rows.map(([k, v]) => `<div class="flex items-center justify-between rounded-xl border px-3 py-2" style="border-color: var(--border); background: var(--bg-elev-2)"><dt style="color: var(--text-muted)">${k}</dt><dd style="color: var(--text)">${v}</dd></div>`).join("");
    }
    text.addEventListener("input", count);
    count();
  </script>
</ToolLayout>
