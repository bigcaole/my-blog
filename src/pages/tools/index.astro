---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import { SITE } from "../../config/site";
import { TOOL_CATEGORIES } from "../../config/toolCategories";

const title = "工具箱";
const description = "面向开发、站长、文本处理、安全与前端设计的一组在线小工具。";

const tools = SITE.tools.map((tool) => ({
  ...tool,
  category: tool.category ?? "developer",
  href: tool.status === "live" ? `/tools/${tool.slug}/` : `/tools/coming-soon/${tool.slug}/`,
  searchText: [tool.title, tool.slug, tool.description, tool.category, ...(tool.keywords ?? [])]
    .join(" ")
    .toLowerCase(),
}));

const liveCount = tools.filter((tool) => tool.status === "live").length;
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto w-full max-w-6xl px-0 py-2">
    <header class="grid gap-6 lg:grid-cols-[1fr_340px] lg:items-end">
      <div>
        <p class="text-sm font-medium" style="color: var(--primary)">Tools</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl" style="color: var(--text)">{title}</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7" style="color: var(--text-muted)">{description}</p>
      </div>

      <div class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div>
            <div class="text-2xl font-semibold" style="color: var(--text)">{liveCount}</div>
            <div style="color: var(--text-muted)">可用工具</div>
          </div>
          <div>
            <div class="text-2xl font-semibold" style="color: var(--text)">{TOOL_CATEGORIES.length}</div>
            <div style="color: var(--text-muted)">功能分类</div>
          </div>
        </div>
      </div>
    </header>

    <div
      class="mt-8 rounded-2xl border p-3"
      style="background: color-mix(in srgb, var(--bg-elev-1) 88%, transparent); border-color: var(--border)"
      data-tools-filter
    >
      <div class="grid gap-3 lg:grid-cols-[1fr_auto] lg:items-center">
        <label class="relative block">
          <span class="sr-only">搜索工具</span>
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2" style="color: var(--text-muted)">
            <Icon name="search" size={16} />
          </span>
          <input
            id="tool-search"
            class="h-11 w-full rounded-xl border py-2 pl-10 pr-3 text-sm outline-none"
            style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)"
            placeholder="搜索 JSON、DNS、二维码、密码、颜色…"
            autocomplete="off"
          />
        </label>

        <nav class="flex gap-2 overflow-x-auto pb-1 lg:pb-0" aria-label="工具分类导航">
          <a class="tool-filter-pill" href="#all" data-filter-category="all">全部</a>
          {TOOL_CATEGORIES.map((category) => (
            <a class="tool-filter-pill" href={`#${category.key}`} data-filter-category={category.key}>
              <Icon name={category.icon as any} size={15} />
              {category.shortTitle}
            </a>
          ))}
        </nav>
      </div>
    </div>

    <section
      id="personal-tools"
      class="mt-8 hidden grid gap-4 lg:grid-cols-2"
      aria-label="个人工具导航"
    >
      <div class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold" style="color: var(--text)">我的收藏</h2>
          <button type="button" class="tool-text-button" data-clear-favorites>清空</button>
        </div>
        <div id="favorite-tools" class="grid gap-2"></div>
      </div>
      <div class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold" style="color: var(--text)">最近使用</h2>
          <button type="button" class="tool-text-button" data-clear-recent>清空</button>
        </div>
        <div id="recent-tools" class="grid gap-2"></div>
      </div>
    </section>

    <p id="tool-empty" class="mt-6 hidden rounded-2xl border p-4 text-sm" style="border-color: var(--border); color: var(--text-muted); background: var(--bg-elev-1)">
      没有匹配的工具，换个关键词试试。
    </p>

    <div class="mt-8 grid gap-10">
      {TOOL_CATEGORIES.map((category) => {
        const group = tools.filter((tool) => tool.category === category.key);
        if (!group.length) return null;

        return (
          <section id={category.key} data-tool-section={category.key} class="scroll-mt-24">
            <div class="mb-4 flex items-start gap-3">
              <div
                class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl border"
                style="background: var(--bg-elev-1); border-color: var(--border); color: var(--primary)"
              >
                <Icon name={category.icon as any} size={18} />
              </div>
              <div>
                <h2 class="text-xl font-semibold" style="color: var(--text)">{category.title}</h2>
                <p class="mt-1 text-sm" style="color: var(--text-muted)">{category.description}</p>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.map((tool) => {
                const live = tool.status === "live";
                return (
                  <article
                    class="tool-card group rounded-2xl border p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
                    style="background: var(--bg-elev-1); border-color: var(--border)"
                    data-tool-card
                    data-category={category.key}
                    data-slug={tool.slug}
                    data-title={tool.title}
                    data-href={tool.href}
                    data-search={tool.searchText}
                  >
                    <div class="flex items-start justify-between gap-3">
                      <div class="flex min-w-0 items-center gap-3">
                        <div
                          class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl border"
                          style="background: var(--bg-elev-2); border-color: var(--border); color: var(--primary)"
                        >
                          <Icon name={(tool.icon || category.icon) as any} size={18} />
                        </div>
                        <div class="min-w-0">
                          <h3 class="truncate text-base font-semibold" style="color: var(--text)">{tool.title}</h3>
                          <p class="mt-0.5 text-xs" style="color: var(--text-muted)">{live ? "可用" : "开发中"}</p>
                        </div>
                      </div>
                      <div class="flex shrink-0 items-center gap-2">
                        <button
                          type="button"
                          class="tool-favorite"
                          data-favorite-toggle={tool.slug}
                          aria-label={`收藏 ${tool.title}`}
                          title="收藏工具"
                        >
                          <Icon name="star" size={15} />
                        </button>
                        <span
                          class="rounded-full border px-2 py-1 text-xs"
                          style={`border-color: var(--border); color: ${live ? "var(--accent)" : "var(--text-muted)"}; background: var(--bg-elev-2)`}
                        >
                          {live ? "Live" : "WIP"}
                        </span>
                      </div>
                    </div>

                    <p class="mt-3 min-h-[3.5rem] text-sm leading-7" style="color: var(--text-muted)">
                      {tool.description || "点开即用的小工具。"}
                    </p>

                    <div class="mt-4">
                      <a
                        class="inline-flex h-10 items-center justify-center gap-2 rounded-xl px-3 text-sm font-medium shadow-sm transition active:scale-[0.98]"
                        style={live ? "background: linear-gradient(135deg, var(--primary), var(--accent)); color: white" : "border: 1px solid var(--border); color: var(--text)"}
                        href={tool.href}
                        data-tool-open={tool.slug}
                      >
                        {live ? "进入" : "查看"}
                        <Icon name="arrow-right" size={15} />
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <style>
    .tool-filter-pill {
      display: inline-flex;
      height: 2.75rem;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border-radius: 0.75rem;
      border: 1px solid var(--border);
      padding: 0 0.8rem;
      color: var(--text);
      background: var(--bg-elev-2);
      font-size: 0.875rem;
      font-weight: 600;
      white-space: nowrap;
      text-decoration: none;
    }
    .tool-filter-pill:hover,
    .tool-filter-pill.is-active {
      color: white;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-color: transparent;
      text-decoration: none;
    }
    .tool-favorite {
      display: inline-grid;
      height: 2rem;
      width: 2rem;
      place-items: center;
      border-radius: 0.75rem;
      border: 1px solid var(--border);
      color: var(--text-muted);
      background: var(--bg-elev-2);
      transition: color 150ms ease, background 150ms ease, border-color 150ms ease;
    }
    .tool-favorite:hover,
    .tool-favorite.is-active {
      color: #f59e0b;
      border-color: color-mix(in srgb, #f59e0b 40%, var(--border));
      background: color-mix(in srgb, #f59e0b 12%, var(--bg-elev-2));
    }
    .tool-text-button {
      border: 0;
      color: var(--text-muted);
      background: transparent;
      font-size: 0.8125rem;
      cursor: pointer;
    }
    .tool-text-button:hover {
      color: var(--primary);
      text-decoration: underline;
    }
    .tool-mini-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-radius: 0.75rem;
      border: 1px solid var(--border);
      background: var(--bg-elev-2);
      padding: 0.7rem 0.8rem;
      color: var(--text);
      font-size: 0.875rem;
      text-decoration: none;
    }
    .tool-mini-link:hover {
      color: var(--primary);
      text-decoration: none;
      border-color: color-mix(in srgb, var(--primary) 30%, var(--border));
    }
  </style>

  <script is:inline>
    const storageKeys = {
      favorites: "tools:favorites",
      recent: "tools:recent",
    };
    const search = document.getElementById("tool-search");
    const cards = Array.from(document.querySelectorAll("[data-tool-card]"));
    const sections = Array.from(document.querySelectorAll("[data-tool-section]"));
    const empty = document.getElementById("tool-empty");
    const pills = Array.from(document.querySelectorAll("[data-filter-category]"));
    const personalTools = document.getElementById("personal-tools");
    const favoriteTools = document.getElementById("favorite-tools");
    const recentTools = document.getElementById("recent-tools");
    let activeCategory = "all";

    const toolMap = new Map(
      cards.map((card) => [
        card.dataset.slug,
        {
          slug: card.dataset.slug,
          title: card.dataset.title,
          href: card.dataset.href,
          category: card.dataset.category,
        },
      ])
    );

    function readList(key) {
      try {
        const value = JSON.parse(localStorage.getItem(key) || "[]");
        return Array.isArray(value) ? value.filter((slug) => toolMap.has(slug)) : [];
      } catch (error) {
        return [];
      }
    }

    function writeList(key, value) {
      localStorage.setItem(key, JSON.stringify(value));
    }

    function recordRecent(slug) {
      if (!toolMap.has(slug)) return;
      const next = [slug, ...readList(storageKeys.recent).filter((item) => item !== slug)].slice(0, 8);
      writeList(storageKeys.recent, next);
    }

    function miniLink(tool) {
      const a = document.createElement("a");
      a.className = "tool-mini-link";
      a.href = tool.href;
      a.dataset.toolOpen = tool.slug;
      a.innerHTML = `<span>${tool.title}</span><span aria-hidden="true">→</span>`;
      return a;
    }

    function emptyText(text) {
      const p = document.createElement("p");
      p.className = "text-sm";
      p.style.color = "var(--text-muted)";
      p.textContent = text;
      return p;
    }

    function renderPersonalTools() {
      const favorites = readList(storageKeys.favorites);
      const recent = readList(storageKeys.recent);

      for (const button of document.querySelectorAll("[data-favorite-toggle]")) {
        button.classList.toggle("is-active", favorites.includes(button.dataset.favoriteToggle));
        button.setAttribute("aria-pressed", favorites.includes(button.dataset.favoriteToggle) ? "true" : "false");
      }

      favoriteTools.replaceChildren(
        ...(favorites.length ? favorites.map((slug) => miniLink(toolMap.get(slug))) : [emptyText("点击工具卡片右上角星标收藏。")])
      );
      recentTools.replaceChildren(
        ...(recent.length ? recent.map((slug) => miniLink(toolMap.get(slug))) : [emptyText("进入工具后会自动记录。")])
      );
      personalTools.classList.toggle("hidden", favorites.length === 0 && recent.length === 0);
    }

    function setActivePill() {
      for (const pill of pills) {
        pill.classList.toggle("is-active", pill.dataset.filterCategory === activeCategory);
      }
    }

    function applyFilters() {
      const q = (search?.value || "").trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const categoryOk = activeCategory === "all" || card.dataset.category === activeCategory;
        const queryOk = !q || (card.dataset.search || "").includes(q);
        const visible = categoryOk && queryOk;
        card.classList.toggle("hidden", !visible);
        if (visible) shown++;
      }
      for (const section of sections) {
        const visibleCards = section.querySelectorAll("[data-tool-card]:not(.hidden)").length;
        section.classList.toggle("hidden", visibleCards === 0);
      }
      empty?.classList.toggle("hidden", shown !== 0);
      setActivePill();
    }

    for (const pill of pills) {
      pill.addEventListener("click", (event) => {
        const next = pill.dataset.filterCategory || "all";
        activeCategory = next;
        if (next === "all") {
          event.preventDefault();
          history.replaceState(null, "", "#all");
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
        applyFilters();
      });
    }

    search?.addEventListener("input", applyFilters);

    document.addEventListener("click", (event) => {
      const favoriteButton = event.target.closest("[data-favorite-toggle]");
      if (favoriteButton) {
        const slug = favoriteButton.dataset.favoriteToggle;
        const favorites = readList(storageKeys.favorites);
        const next = favorites.includes(slug) ? favorites.filter((item) => item !== slug) : [slug, ...favorites].slice(0, 12);
        writeList(storageKeys.favorites, next);
        renderPersonalTools();
        return;
      }

      const openLink = event.target.closest("[data-tool-open]");
      if (openLink) recordRecent(openLink.dataset.toolOpen);
    });

    document.querySelector("[data-clear-favorites]")?.addEventListener("click", () => {
      writeList(storageKeys.favorites, []);
      renderPersonalTools();
    });
    document.querySelector("[data-clear-recent]")?.addEventListener("click", () => {
      writeList(storageKeys.recent, []);
      renderPersonalTools();
    });

    const fromHash = location.hash.replace("#", "");
    if (fromHash && pills.some((pill) => pill.dataset.filterCategory === fromHash)) {
      activeCategory = fromHash;
    }
    applyFilters();
    renderPersonalTools();
  </script>
</BaseLayout>
