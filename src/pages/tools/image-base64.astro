---
import ToolLayout from "../../layouts/ToolLayout.astro";

const title = "图片转 Base64";
const description = "上传小图片并生成可嵌入 HTML 或 CSS 的 Base64 Data URL。";
---

<ToolLayout title={title} description={description}>
  <div class="grid gap-4 lg:grid-cols-[360px_1fr]">
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <label class="text-sm font-medium" style="color: var(--text)" for="file">选择图片</label>
      <input id="file" type="file" accept="image/*" class="mt-3 block w-full text-sm" style="color: var(--text)" />
      <img id="preview" class="mt-4 hidden max-h-64 w-full rounded-xl border object-contain p-2" style="border-color: var(--border); background: var(--bg-elev-2)" alt="图片预览" />
      <dl id="meta" class="mt-4 grid gap-2 text-sm"></dl>
    </section>
    <section class="rounded-2xl border p-4" style="background: var(--bg-elev-1); border-color: var(--border)">
      <div class="mb-2 flex items-center justify-between">
        <div class="text-sm font-medium" style="color: var(--text)">Data URL</div>
        <button id="copy" class="ui-btn ui-btn--secondary" type="button">复制</button>
      </div>
      <textarea id="out" class="min-h-[420px] w-full resize-y rounded-xl border p-3 font-mono text-xs outline-none" style="background: var(--bg-elev-2); border-color: var(--border); color: var(--text)" readonly></textarea>
    </section>
  </div>

  <script is:inline>
    const fileInput = document.getElementById("file");
    const out = document.getElementById("out");
    const preview = document.getElementById("preview");
    const meta = document.getElementById("meta");
    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const value = String(reader.result || "");
        out.value = value;
        preview.src = value;
        preview.classList.remove("hidden");
        meta.innerHTML = [
          ["文件名", file.name],
          ["类型", file.type || "未知"],
          ["大小", `${(file.size / 1024).toFixed(2)} KB`],
          ["长度", `${value.length} 字符`],
        ].map(([k, v]) => `<div class="flex justify-between gap-3 rounded-xl border px-3 py-2" style="border-color: var(--border); background: var(--bg-elev-2)"><dt style="color: var(--text-muted)">${k}</dt><dd style="color: var(--text); word-break: break-all">${v}</dd></div>`).join("");
      };
      reader.readAsDataURL(file);
    });
    document.getElementById("copy").addEventListener("click", () => navigator.clipboard.writeText(out.value || ""));
  </script>
</ToolLayout>
