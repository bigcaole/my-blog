---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Card from '../components/ui/Card.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
import SubscribeEmbed from '../components/shared/SubscribeEmbed.astro';
---

<BaseLayout title="关于" description={`关于 ${SITE.name}：极简 + 工具型个人站点。`} canonical="/about/">
  <SectionTitle title="关于" description="一个「极简但有层次」的技术博客 / 工具站。" />

  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    <Card class="p-5">
      <div class="text-sm font-semibold" style="color: var(--text)">站点信息</div>
      <ul class="mt-4 space-y-2 text-sm" style="color: var(--text-muted)">
        <li class="flex items-center gap-2">
          <Icon name="sparkles" size={16} /> {SITE.slogan}
        </li>
        <li class="flex items-center gap-2">
          <Icon name="posts" size={16} /> Markdown 写作（content collections）
        </li>
        <li class="flex items-center gap-2">
          <Icon name="tools" size={16} /> 工具页：IP / Base64 / Cron（持续扩展）
        </li>
        <li class="flex items-center gap-2">
          <Icon name="monitor" size={16} /> 深色模式：跟随系统 + 手动切换
        </li>
      </ul>
      <div class="mt-5 flex flex-wrap gap-2">
        <Button variant="primary" href="/posts/">
          <Icon name="posts" size={16} /> 查看文章
        </Button>
        <Button variant="secondary" href="/tools/">
          <Icon name="tools" size={16} /> 工具箱
        </Button>
      </div>
    </Card>

    <Card class="p-5">
      <div class="text-sm font-semibold" style="color: var(--text)">配置入口</div>
      <p class="mt-2 text-sm" style="color: var(--text-muted)">
        所有可配置项集中在 <code>src/config/site.ts</code>：站点名称/描述、导航、社交链接、工具列表、SEO 默认值、Giscus 与订阅配置等。
      </p>
      <div class="mt-5 text-sm" style="color: var(--text-muted)">
        <div class="font-medium" style="color: var(--text)">社交链接</div>
        <div class="mt-3 flex flex-wrap gap-2">
          {SITE.social.github ? (
            <Button variant="secondary" href={SITE.social.github} target="_blank" rel="noreferrer">
              <Icon name="github" size={16} /> GitHub
            </Button>
          ) : null}
          {SITE.social.telegram ? (
            <Button variant="secondary" href={SITE.social.telegram} target="_blank" rel="noreferrer">
              <Icon name="telegram" size={16} /> Telegram
            </Button>
          ) : null}
          {SITE.social.x ? (
            <Button variant="secondary" href={SITE.social.x} target="_blank" rel="noreferrer">
              <Icon name="x" size={16} /> X
            </Button>
          ) : null}
          {SITE.social.email ? (
            <Button variant="secondary" href={`mailto:${SITE.social.email}`}>
              <Icon name="mail" size={16} /> Email
            </Button>
          ) : null}
        </div>
      </div>
    </Card>
  </div>

  <div class="mt-10">
    <SubscribeEmbed />
  </div>
</BaseLayout>
