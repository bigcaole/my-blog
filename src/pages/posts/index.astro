---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import { getAllPosts, getTagCounts } from '../../utils/posts';
import PostCard from '../../components/post/PostCard.astro';

const posts = await getAllPosts();
const tagCounts = getTagCounts(posts);
const tags = Array.from(tagCounts.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="文章" description="文章列表：教程 / 经验 / 随笔 / 综合。" canonical="/posts/">
  <div class="flex flex-col gap-6">
    <SectionTitle title="文章" description="清爽、留白、可检索（顶部搜索）与可筛选（下方标签）。" barClass="border-indigo-500" />

    <Card class="p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
          <label class="text-xs" style="color: var(--text-muted)">
            标签筛选
            <select
              class="ui-input mt-1 h-10 sm:mt-0 sm:ml-2 sm:w-56"
              data-posts-filter
            >
              <option value="">全部</option>
              {tags.map(({ tag, count }) => (
                <option value={tag}>
                  {tag} ({count})
                </option>
              ))}
            </select>
          </label>

          <label class="text-xs" style="color: var(--text-muted)">
            排序
            <select
              class="ui-input mt-1 h-10 sm:mt-0 sm:ml-2 sm:w-40"
              data-posts-sort
            >
              <option value="new">最新优先</option>
              <option value="old">最早优先</option>
            </select>
          </label>
        </div>

        <div class="text-xs" style="color: var(--text-muted)">
          <span class="inline-flex items-center gap-1">
            <Icon name="search" size={14} /> 也可直接用顶部搜索
          </span>
        </div>
      </div>
    </Card>

    <div class="grid gap-4" data-posts-list>
      {posts.map((post) => (
        <div data-posts-item>
          <PostCard post={post} />
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    const filter = document.querySelector('[data-posts-filter]');
    const sort = document.querySelector('[data-posts-sort]');
    const list = document.querySelector('[data-posts-list]');
    const items = Array.from(document.querySelectorAll('[data-posts-item]'));

    function getCardMeta(item) {
      const card = item.querySelector('[data-post-card]');
      const tags = (card?.getAttribute('data-tags') || '').split('|').filter(Boolean);
      const date = card?.getAttribute('data-date') || '';
      return { tags, date };
    }

    function applyFilterAndSort() {
      const tag = filter?.value || '';
      const order = sort?.value || 'new';

      const filtered = items.filter((it) => {
        if (!tag) return true;
        return getCardMeta(it).tags.includes(tag);
      });

      filtered.sort((a, b) => {
        const da = getCardMeta(a).date;
        const db = getCardMeta(b).date;
        return order === 'old' ? da.localeCompare(db) : db.localeCompare(da);
      });

      // hide all
      items.forEach((it) => (it.style.display = 'none'));
      // show + reorder
      filtered.forEach((it) => {
        it.style.display = '';
        list?.appendChild(it);
      });
    }

    filter?.addEventListener('change', applyFilterAndSort);
    sort?.addEventListener('change', applyFilterAndSort);
    applyFilterAndSort();
  </script>
</BaseLayout>
